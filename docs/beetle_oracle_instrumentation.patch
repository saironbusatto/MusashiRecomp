+/* ---- PSXRecomp oracle: cyc_watch (psx.h documents the capture semantics) ---- */
+#define PSXREC_CYC_WATCH_CAP 1024
+typedef struct {
+   uint32_t hit_index;
+   uint32_t pc;         /* matched physical PC */
+   uint64_t cycles;     /* absolute cycles, or the A->B delta in region mode */
+} PsxrecCycWatchEntry;
+
+static PsxrecCycWatchEntry s_cw_ring[PSXREC_CYC_WATCH_CAP];
+int      g_psxrecomp_cyc_watch_armed = 0;
+static uint32_t s_cw_anchor_raw   = 0;
+static uint32_t s_cw_anchor_phys  = 0;
+static uint32_t s_cw_end_raw      = 0;
+static uint32_t s_cw_end_phys     = 0;   /* non-zero selects region (A->B delta) mode */
+static uint32_t s_cw_max_hits     = 16;
+static uint32_t s_cw_hits         = 0;
+static int      s_cw_in_region    = 0;
+static uint64_t s_cw_region_start = 0;
+
+void psxrecomp_cyc_watch_observe(uint32_t pc)
+{
+   const uint32_t phys = pc & 0x1FFFFFFFu;
+   const uint64_t now  = psxrecomp_guest_cycles();
+
+   if (s_cw_end_phys != 0u)               /* region mode: record delta per A->B pass */
+   {
+      if (!s_cw_in_region)
+      {
+         if (phys == s_cw_anchor_phys)
+         {
+            s_cw_region_start = now;
+            s_cw_in_region    = 1;
+         }
+         return;
+      }
+      if (phys != s_cw_end_phys)
+         return;
+      s_cw_ring[s_cw_hits].hit_index = s_cw_hits;
+      s_cw_ring[s_cw_hits].pc        = phys;
+      s_cw_ring[s_cw_hits].cycles    = now - s_cw_region_start;
+      s_cw_hits++;
+      s_cw_in_region = 0;
+   }
+   else                                   /* single-anchor mode: absolute cycles at A */
+   {
+      if (phys != s_cw_anchor_phys)
+         return;
+      s_cw_ring[s_cw_hits].hit_index = s_cw_hits;
+      s_cw_ring[s_cw_hits].pc        = phys;
+      s_cw_ring[s_cw_hits].cycles    = now;
+      s_cw_hits++;
+   }
+
+   if (s_cw_hits >= s_cw_max_hits)
+      g_psxrecomp_cyc_watch_armed = 0;    /* ring full: stop sampling, keep the data */
+}
+
+extern "C" void beetle_cyc_watch_arm(uint32_t anchor_raw, uint32_t end_raw, int n)
+{
+   g_psxrecomp_cyc_watch_armed = 0;       /* disarm first: the observer runs on the CPU thread */
+   if (n < 1)                       n = 1;
+   if (n > PSXREC_CYC_WATCH_CAP)    n = PSXREC_CYC_WATCH_CAP;
+   s_cw_anchor_raw   = anchor_raw;
+   s_cw_anchor_phys  = anchor_raw & 0x1FFFFFFFu;
+   s_cw_end_raw      = end_raw;
+   s_cw_end_phys     = end_raw & 0x1FFFFFFFu;
+   s_cw_max_hits     = (uint32_t)n;
+   s_cw_hits         = 0;
+   s_cw_in_region    = 0;
+   s_cw_region_start = 0;
+   g_psxrecomp_cyc_watch_armed = 1;
+}
+
+extern "C" void beetle_cyc_watch_clear(void)
+{
+   g_psxrecomp_cyc_watch_armed = 0;
+   s_cw_hits      = 0;
+   s_cw_in_region = 0;
+}
+
+extern "C" void beetle_cyc_watch_get_state(uint32_t *anchor_raw, uint32_t *anchor_phys,
+                                           uint32_t *end_raw, uint32_t *end_phys,
+                                           uint32_t *max_hits, uint32_t *hits, int *armed)
+{
+   if (anchor_raw)  *anchor_raw  = s_cw_anchor_raw;
+   if (anchor_phys) *anchor_phys = s_cw_anchor_phys;
+   if (end_raw)     *end_raw     = s_cw_end_raw;
+   if (end_phys)    *end_phys    = s_cw_end_phys;
+   if (max_hits)    *max_hits    = s_cw_max_hits;
+   if (hits)        *hits        = s_cw_hits;
+   if (armed)       *armed       = g_psxrecomp_cyc_watch_armed;
+}
+
+extern "C" int beetle_cyc_watch_get(uint32_t i, uint32_t *hit_index, uint32_t *pc,
+                                    unsigned long long *cycles)
+{
+   if (i >= s_cw_hits)
+      return 0;
+   if (hit_index) *hit_index = s_cw_ring[i].hit_index;
+   if (pc)        *pc        = s_cw_ring[i].pc;
+   if (cycles)    *cycles    = (unsigned long long)s_cw_ring[i].cycles;
+   return 1;
+}
+
+/* ---- PSXRecomp oracle: exception-entry ring (psx.h) ----
+ * Always recording — an exception is rare enough that an unconditional 40-byte
+ * store costs nothing, and the take-point that matters is usually the one that
+ * happened before anyone thought to arm a trace. Oldest entries are dropped. */
+#define PSXREC_EXC_RING_CAP 4096
+typedef struct {
+   uint64_t seq;
+   uint64_t cycles;
+   uint32_t code;      /* EXCEPTION_* */
+   uint32_t pc;        /* PC handed to Exception() */
+   uint32_t next_pc;
+   uint32_t epc;       /* CP0.EPC after the branch-delay adjustment */
+   uint32_t bd;        /* 1 = exception taken in a branch delay slot */
+   uint32_t sr;        /* CP0.SR before the IEc/KUc push */
+   uint32_t cause;
+   uint32_t i_stat;
+   uint32_t i_mask;
+} PsxrecExcEntry;
+
+static PsxrecExcEntry s_exc_ring[PSXREC_EXC_RING_CAP];
+static uint64_t s_exc_seq = 0;   /* total exceptions since boot; ring holds the last CAP */
+
+void psxrecomp_exc_note(uint32_t code, uint32_t pc, uint32_t next_pc,
+                        uint32_t epc, uint32_t bd, uint32_t sr, uint32_t cause)
+{
+   PsxrecExcEntry *e = &s_exc_ring[s_exc_seq % PSXREC_EXC_RING_CAP];
+   e->seq     = s_exc_seq++;
+   e->cycles  = psxrecomp_guest_cycles();
+   e->code    = code;
+   e->pc      = pc;
+   e->next_pc = next_pc;
+   e->epc     = epc;
+   e->bd      = bd;
+   e->sr      = sr;
+   e->cause   = cause;
+   e->i_stat  = IRQ_GetRegister(IRQ_GSREG_STATUS, NULL, 0);
+   e->i_mask  = IRQ_GetRegister(IRQ_GSREG_MASK,   NULL, 0);
+}
+
+/* Emits the complete JSON object the debug server forwards verbatim. Returns
+ * bytes written, or 0 if `cap` cannot hold the whole dump — a truncated dump
+ * would be invalid JSON, which is worse than no dump. */
+extern "C" int retro_psxref_exc_ring_dump(char *out, int cap)
+{
+   if (!out || cap < 256)
+      return 0;
+
+   const uint64_t have  = (s_exc_seq < PSXREC_EXC_RING_CAP) ? s_exc_seq : PSXREC_EXC_RING_CAP;
+   const uint64_t first = s_exc_seq - have;
+
+   int pos = snprintf(out, (size_t)cap,
+      "{\"ok\":true,\"total\":%llu,\"count\":%llu,\"entries\":[",
+      (unsigned long long)s_exc_seq, (unsigned long long)have);
+
+   for (uint64_t i = 0; i < have; i++)
+   {
+      const PsxrecExcEntry *e = &s_exc_ring[(first + i) % PSXREC_EXC_RING_CAP];
+      const int n = snprintf(out + pos, (size_t)(cap - pos),
+         "%s{\"seq\":%llu,\"cycles\":%llu,\"code\":%u,\"pc\":\"0x%08X\","
+         "\"next_pc\":\"0x%08X\",\"epc\":\"0x%08X\",\"bd\":%u,\"sr\":\"0x%08X\","
+         "\"cause\":\"0x%08X\",\"i_stat\":\"0x%08X\",\"i_mask\":\"0x%08X\"}",
+         i ? "," : "", (unsigned long long)e->seq, (unsigned long long)e->cycles,
+         e->code, e->pc, e->next_pc, e->epc, e->bd, e->sr, e->cause,
+         e->i_stat, e->i_mask);
+      if (n < 0 || n >= cap - pos)
+         return 0;
+      pos += n;
+   }
+
+   const int n = snprintf(out + pos, (size_t)(cap - pos), "]}");
+   if (n < 0 || n >= cap - pos)
+      return 0;
+   return pos + n;
+}
