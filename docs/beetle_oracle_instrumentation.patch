+/* ---- PSXRecomp oracle: guest cycle clock ----
+ *
+ * The core's `timestamp` restarts at 0 every retro_run, so it cannot be
+ * compared against the runtime's psx_cycle_count, which counts from boot.
+ * Absolute cycles = cycles retired by completed frames + the current in-frame
+ * timestamp. The CPU loop publishes the second half once per instruction; the
+ * frame loop folds it into the base when Run() returns.
+ *
+ * Read across threads by the debug server: a 64+32 read can tear. This is an
+ * observation-only clock (no emulation decision reads it), and the native side
+ * samples its counter just as loosely, so a torn sample costs one bad row in a
+ * diff, never a behaviour change. */
+extern uint64_t g_psxrecomp_cyc_base;      /* cycles retired in completed frames */
+extern int32_t  g_psxrecomp_cyc_in_frame;  /* current timestamp inside Run()     */
+uint64_t psxrecomp_guest_cycles(void);
+
+/* ---- PSXRecomp oracle: cyc_watch, the Beetle half of the per-anchor cycle
+ * comparator. Capture semantics are dictated by the native implementation
+ * (runtime/src/debug_server.c) and must match it exactly: the anchor is
+ * sampled BEFORE the anchor instruction executes, so the recorded cycle count
+ * excludes every cycle of the anchored instruction. Native only observes at
+ * basic-block leaders; Beetle observes at every instruction, which is a
+ * superset — an anchor that is a block leader on the native side fires at the
+ * same architectural point on both. Anchors are compared as physical
+ * addresses (pc & 0x1FFFFFFF). */
+extern int g_psxrecomp_cyc_watch_armed;    /* hot-path gate; 0 = observer is dead code */
+void psxrecomp_cyc_watch_observe(uint32_t pc);
+
+/* ---- PSXRecomp oracle: exception-entry ring. Records the architectural
+ * take-point of every CPU exception so the runtime's IRQ take-PC can be
+ * arbitrated against real-hardware behaviour by ORDER + EPC VALUE (raw cycle
+ * counts are not comparable across emulators). */
+void psxrecomp_exc_note(uint32_t code, uint32_t pc, uint32_t next_pc,
+                        uint32_t epc, uint32_t bd, uint32_t sr, uint32_t cause);
+
 #endif
