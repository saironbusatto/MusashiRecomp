--- a/mednafen/psx/irq.cpp
+++ b/mednafen/psx/irq.cpp
@@ -75,6 +75,13 @@
       Status |= (old_Asserted ^ Asserted) & Asserted;
    }
 
+   /* PSXRecomp oracle: report only the RISING edge. IRQ_Assert is called on
+    * every poll by several devices, so firing unconditionally would bury the
+    * consumer's ring in duplicates; old_Asserted vs Asserted isolates the
+    * transition that actually matters for cross-checking IRQ delivery. */
+   if(MDFN_UNLIKELY(g_psxrecomp_irq_cb) && ((old_Asserted ^ Asserted) & (1 << which)) && status)
+      g_psxrecomp_irq_cb(which);
