+/* PSXRecomp oracle: CPU-load (read) trace callback — the read-side mirror of
+ * g_psxrecomp_wtrace_cb. Fired from the live interpreter after each LB/LBU/
+ * LH/LHU/LW retires its ReadMemory, with the same argument shape as the write
+ * side so both can share one consumer.
+ *   addr  = effective address
+ *   value = the loaded value, zero-extended to 32 bits
+ *   pc    = PC of the load instruction
+ *   ra    = GPR[31] at the load
+ *   size  = 1, 2 or 4 bytes
+ *
+ * NOTE: these last two hooks were NOT part of the three in-repo patches
+ * (docs/beetle_*.patch); runtime/src/beetle_libretro.cpp had grown to require
+ * them and no matching beetle-psx patch was ever committed, so the documented
+ * build recipe could not link. Added here to close that gap. */
+typedef void (*psxrecomp_rtrace_cb_t)(uint32_t addr, uint32_t value,
+                                      uint32_t pc, uint32_t ra, uint8_t size);
+extern psxrecomp_rtrace_cb_t g_psxrecomp_rtrace_cb;
+
+/* PSXRecomp oracle: IRQ assert/deassert edge callback.
+ *   which = IRQ line index (see IRQ_Assert in irq.cpp) */
+typedef void (*psxrecomp_irq_cb_t)(int which);
+extern psxrecomp_irq_cb_t g_psxrecomp_irq_cb;
+
 #endif
